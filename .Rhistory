leagueDB <- data.frame()
totalData <- data.frame()
for (i in 60:70){
leagueLink <- paste0("https://index.simulationhockey.com/api/v1/players/ratings?season=", i)
result <- GET(leagueLink)
data <- fromJSON(rawToChar(result$content))
standings <- paste0("https://index.simulationhockey.com/api/v1/teams?season=",i)
standingsresult <- GET(standings)
standingsData <- fromJSON(rawToChar(standingsresult$content))
standingsData <- unnest(standingsData, stats)
standingsData <- standingsData %>%
select(season, team = abbreviation, wins, losses,overtimeLosses, points, goalsFor, goalsAgainst,winPercent)
data$position <- gsub("LD", "D", data$position)
data$position <- gsub("RD", "D", data$position)
data$position <- gsub("LW", "F", data$position)
data$position <- gsub("RW", "F", data$position)
data$position <- gsub("C", "F", data$position)
special <- data %>%
select(name, season,team,position,appliedTPE)
data <- data %>%
select(season,team,position,appliedTPE)
totalData <- rbind(special, totalData)
summary_data <- data %>%
group_by(season, team, position) %>%
dplyr::summarise(avg_TPE = mean(appliedTPE))
team_avg <- summary_data %>%
group_by(season, team) %>%
dplyr::summarise(avg_TPE_per_team = mean(avg_TPE))
filtered_avg <- summary_data %>%
filter(position %in% c("F", "D")) %>%
group_by(season, team) %>%
pivot_wider(names_from = position, values_from = avg_TPE, names_prefix = "avg_TPE_per_")
result <- left_join(team_avg, filtered_avg, by = c("season", "team"))
combined_df <- merge(result, standingsData, by = c("season", "team"))
totalDB <- rbind(combined_df, totalDB)
league_data <- data %>%
group_by(season) %>%
dplyr::summarise(averageTPE = mean(appliedTPE))
# Filter positions "F" and "D" and calculate average TPE per position
league_avg <- data %>%
filter(position %in% c("F", "D")) %>%
group_by(season, position) %>%
dplyr::summarise(avgTPE = mean(appliedTPE))
# Pivot the filtered averages to have separate columns for forward and defense TPE
pivoted_avg <- league_avg %>%
pivot_wider(names_from = position, values_from = avgTPE,
names_prefix = "average", values_fill = 0)
# Merge the average TPE and pivoted averages by season
league <- left_join(league_data, pivoted_avg, by = "season")
leagueDB <- rbind(league, leagueDB)
}
write.csv(totalDB, "\\Users\\Luke\\Documents\\R\\totalDB.csv")
